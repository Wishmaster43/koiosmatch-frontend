#!/bin/sh
# PROC-1 gate — no red main. Blocks a commit that breaks typecheck or lint (the
# exact class of failure that slipped in on 2026-07-01: a file passing vitest but
# breaking `tsc`). Runs the same checks as CI. Real emergency escape: --no-verify.
#
# Shared without husky: package.json's "prepare" points git at .githooks via
# core.hooksPath, so every clone/install gets this gate.

echo "▶ pre-commit: typecheck…"
npm run --silent typecheck || {
  echo "✗ tsc failed — fix the type errors before committing (or, only if you must: git commit --no-verify)"
  exit 1
}
echo "▶ pre-commit: lint + huisstijl-plafond…"
# One `eslint .` json run checks BOTH: errors anywhere (the old lint step) and the
# shrink-only per-file warning CEILING (herhaal-slotaudit §7.1 — the staged check
# below only guards files you touch; the ceiling catches new drift in UNTOUCHED
# legacy files too). Debt paid down? Lower the snapshot: npm run huisstijl:ceiling -- --write
node scripts/huisstijl-ceiling.mjs || {
  echo "✗ eslint errors or a HUISSTIJL ceiling breach — see above"
  exit 1
}
# HUISSTIJL slotaudit §2.3: a handful of selectors (link-as-button, raw <button>
# style, 15px titles, …) carry hundreds of pre-existing hits, so they stay 'warn'
# in eslint.config.js — a global --max-warnings 0 would block on debt this audit
# did not touch. Every file you STAGE still gets the hard check: --max-warnings 0
# on exactly the staged .js/.jsx/.ts/.tsx files, so new drift can't land while the
# rest of the tree pays down over time.
echo "▶ pre-commit: staged HUISSTIJL check (--max-warnings 0 on files you touch)…"
STAGED_JS_TS=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(t|j)sx?$')
if [ -n "$STAGED_JS_TS" ]; then
  # shellcheck disable=SC2086 — intentional word-splitting: each line is one path.
  npx eslint --max-warnings=0 $STAGED_JS_TS || {
    echo "✗ a staged file still carries a HUISSTIJL warning (raw-button style, link-as-button, 15px title, …) — fix it before committing (pre-existing debt elsewhere in the tree does not block; only files you touch do)"
    exit 1
  }
fi
echo "▶ pre-commit: i18n parity…"
npx vitest run src/i18n/localeParity.test.ts || {
  echo "✗ i18n parity failed — a locale (de/fr/es/en) is missing keys nl has. Add them (all 5 locales) before committing."
  exit 1
}
# HUISSTIJL slotaudit: the typography ratchet (frozen, shrink-only SectionTitle/
# Caption allowlists) — a file's hand-styled count may never grow, and a file
# migrated to the shared atom must drop out of (or shrink in) the allowlist.
echo "▶ pre-commit: typografie-ratchet…"
npx vitest run src/components/ui/typography.houseStyle.test.js || {
  echo "✗ typography ratchet failed — a file's hand-styled SectionTitle/Caption count grew beyond its frozen allowlist entry. Use <SectionTitle>/<Caption> from components/ui/typography, or lower the allowlist entry if it genuinely shrank."
  exit 1
}
# gen:types freshness (C-CHIP #4): api-generated.ts must match the backend spec.
# Regenerates when the sibling spec exists; a diff means the contract moved — the
# regenerated file is left in place: `git add src/types/api-generated.ts` and retry.
if [ -f ../koiosmatch-api/docs/openapi.yaml ]; then
  echo "▶ pre-commit: gen:types freshness…"
  npm run --silent gen:types >/dev/null 2>&1
  if ! git diff --quiet src/types/api-generated.ts; then
    echo "✗ api-generated.ts was behind the spec — just regenerated: git add src/types/api-generated.ts and commit again"
    exit 1
  fi
fi
echo "✓ gate passed (tsc 0, lint 0 errors, i18n parity, typography ratchet, types fresh)"
