# Copy this file to .env and adjust per environment.
# API base URL the frontend talks to. MUST be https in production (see security #3).
VITE_API_URL=http://koiosmatch-api.test/api

# Optional: base URL for the workflow-EXECUTION endpoints only (runs, run/cancel,
# logs, queue status) — the workflow engine is planned to move to its own server
# (decision 2026-06-23). Falls back to VITE_API_URL when unset, so today (engine
# and API on one host) nothing changes. Workflow-definition CRUD always stays on
# VITE_API_URL.
# VITE_WORKFLOW_API_URL=http://koiosmatch-workflow-engine.test/api

# Auth: httpOnly cookie + CSRF is the ONLY mode (H3, 2026-07-08) — the legacy
# Bearer flow was removed from the code; no env var can re-enable it.
# CSRF cookie endpoint (Laravel Sanctum). Defaults to <api-root>/sanctum/csrf-cookie.
# VITE_CSRF_URL=http://koiosmatch-api.test/sanctum/csrf-cookie

# Content-Security-Policy (production builds only, CSP-1): `vite.config.js` reads
# VITE_API_URL / VITE_WORKFLOW_API_URL / VITE_CSRF_URL above via loadEnv() and
# builds the policy in src/lib/csp.ts — set them ABSOLUTE (https://…) for a
# production build so their origins land in connect-src/img-src. A relative
# value (dev proxy shape, e.g. "/api") already resolves against 'self' and
# contributes no extra origin.
