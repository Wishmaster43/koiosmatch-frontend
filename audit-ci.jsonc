{
  // Dependency-audit gate (heraudit SEC-1/2/3, 20-08): `npm run security:audit` fails on any
  // HIGH/CRITICAL advisory not explicitly allowlisted here, and the landing script runs the same
  // check for every bucket that touches package.json / package-lock.json / this file
  // (AUDIT-GATE-IN-LANDING-1).
  //
  // MAJORS-FE-1 step 1 (29-10-2026): the allowlist is EMPTY. The five entries it carried were all
  // in the dev-only vitest 2 chain (vitest, vite dev server, launch-editor, two tinypool
  // prototype-pollution advisories); vitest 5.0.5 (vite 8 underneath) / jsdom 30 retired them and audit-ci
  // now reports "consider not allowlisting" for each, so they are dropped (DEPS-AUDIT-FE-2
  // precedent: an entry audit-ci no longer reports is removed, never kept "just in case" — should
  // one come back, this gate fails loudly instead of hiding it).
  //
  // Rules for any future entry: one advisory per line, its reason on the same line, and a
  // machine-readable `expires YYYY-MM-DD`; scripts/auditAllowlistExpiry.houseStyle.test.mjs fails
  // the suite once that date has passed, so a revalidation is a deliberate act (re-check dev-only,
  // move the date in the same commit) and never forgotten. An empty list is the goal state.
  "high": true,
  "allowlist": []
}
