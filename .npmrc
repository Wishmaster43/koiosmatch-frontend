# DEPS-AUDIT-FE-1 (21-10-2026): refuse npm install/ci on a Node below the security floor in
# package.json "engines" (nodejs.org 21-10 release: Brotli decoder RCE CVE-2026-111497, TLS
# hostname bypasses). Mirrors the API gateway floor; a vulnerable interpreter never passes a deploy.
engine-strict=true
